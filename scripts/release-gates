#!/usr/bin/env bash

mode="${1:-full}"

print_rule() {
    printf '%*s\n' 72 '' | tr ' ' '='
}

run_gate() {
    local name="$1"
    shift

    echo
    print_rule
    echo " GATE: $name"
    print_rule
    echo

    "$@"
    local status=$?

    if [[ $status -ne 0 ]]; then
        echo
        echo "FAILED: $name"
        echo "Exit status: $status"
        exit "$status"
    fi

    echo
    echo "PASS: $name"
}

require_command() {
    local command_name="$1"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "error: required command not found: $command_name" >&2
        exit 127
    fi
}

require_repo_root() {
    if [[ ! -f Cargo.toml ]]; then
        echo "error: run this script from the wraithflow repository root" >&2
        exit 1
    fi

    if ! grep -q '^name = "wraithflow"' Cargo.toml; then
        echo "error: this does not appear to be the wraithflow repository" >&2
        exit 1
    fi
}

# No [features] section exists anywhere in this workspace -- no
# --all-features matrix to vary, unlike ghostport.
run_quick_gates() {
    run_gate \
        "Unstaged whitespace" \
        git diff --check

    run_gate \
        "Staged whitespace" \
        git diff --cached --check

    run_gate \
        "Formatting" \
        cargo fmt --all -- --check

    run_gate \
        "Check" \
        cargo check \
            --workspace \
            --all-targets

    run_gate \
        "Clippy" \
        cargo clippy \
            --workspace \
            --all-targets \
            -- \
            -D warnings

    run_gate \
        "Strict rustdoc (wf-core public API)" \
        env RUSTDOCFLAGS="-D warnings" \
        cargo doc \
            -p wf-core \
            --no-deps

    run_gate \
        "Strict rustdoc (wf-packet public API)" \
        env RUSTDOCFLAGS="-D warnings" \
        cargo doc \
            -p wf-packet \
            --no-deps

    run_gate \
        "Strict rustdoc (wf-proxy public API)" \
        env RUSTDOCFLAGS="-D warnings" \
        cargo doc \
            -p wf-proxy \
            --no-deps
}

run_full_gates() {
    run_quick_gates

    run_gate \
        "Tests" \
        cargo test \
            --workspace \
            --all-targets

    if command -v cargo-deny >/dev/null 2>&1; then
        run_gate \
            "Supply-chain checks (cargo deny)" \
            cargo deny check
    else
        echo
        echo "SKIPPED: Supply-chain checks (cargo-deny not installed -- see README)"
    fi
}

require_command cargo
require_command git
require_repo_root

echo
print_rule
echo " WRAITHFLOW RELEASE GATES"
print_rule
echo
echo "Mode       : $mode"
echo "Repository : $(pwd)"
echo "Revision   : $(git rev-parse --short HEAD 2>/dev/null || echo '(no commits yet)')"
echo "Branch     : $(git branch --show-current 2>/dev/null || echo '(none)')"

case "$mode" in
    quick)
        run_quick_gates
        ;;

    full)
        run_full_gates
        ;;

    *)
        echo
        echo "Usage:"
        echo "  ./scripts/release-gates quick"
        echo "  ./scripts/release-gates full"
        echo
        exit 2
        ;;
esac

echo
print_rule
echo " ALL REQUESTED WRAITHFLOW GATES GREEN"
print_rule
echo
